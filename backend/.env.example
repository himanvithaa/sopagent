# OPERA Configuration
PROJECT_NAME="OPERA – Intelligent Operations Assistant"
API_V1_STR="/api"

# Local Ollama AI Settings
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_CHAT_MODEL="llama3.2"
OLLAMA_EMBED_MODEL="nomic-embed-text"
OLLAMA_REQUEST_TIMEOUT=90.0

# Database Configuration (PostgreSQL / SQLite)
# For PostgreSQL: postgresql://postgres:password@localhost:5432/opera_db
# SQLite is used as the default zero-config store if DATABASE_URL is not set:
DATABASE_URL="sqlite:///./opera.db"

# Vector Database (ChromaDB)
CHROMA_PERSIST_DIRECTORY="./chroma_db"

# File Storage
STORAGE_DIRECTORY="./storage"
MAX_UPLOAD_SIZE_MB=50
